# ===================================
# 循途 FoloWay · 后端环境变量模板（server/.env.example）
#
# 用法：
#   1) 复制为 .env        —— 放非敏感默认值，可提交入库
#   2) 复制为 .env.local  —— 放真实密钥（数据库密码、AI Key 等），已被 .gitignore 忽略
# 加载顺序：.env → .env.local（后者覆盖前者），由 app/core/config.py 读取
# 说明：留空的配置项会使用代码内默认值；标注【必填】的项不填会导致对应功能不可用
# ===================================

# ---------------- 应用 ----------------
APP_NAME=循途
# development=开发环境（自动补本机局域网 IP 到跨域白名单）；production=生产环境
APP_ENV=development
# 调试模式：生产环境必须为 false
APP_DEBUG=false
# 监听地址与端口（start_all.bat / uvicorn 命令行为准，此处仅作配置记录）
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------------- MySQL ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 【必填·敏感】真实密码请写在 .env.local，不要提交
DB_PASSWORD=your_mysql_password
DB_NAME=ai_habit_partner

# ---------------- Redis ----------------
# 未安装或留空时，依赖 Redis 的缓存功能自动降级，不影响主流程
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------------- JWT 鉴权 ----------------
# 【必填·敏感】生产环境必须是 32 位以上随机字符串；泄露等于所有账号可被伪造
JWT_SECRET=change-me-at-least-32-chars
JWT_ALGORITHM=HS256
# C 端登录 token 有效期（天）
JWT_EXPIRE_DAYS=7
# 管理后台 token 有效期（小时），与 C 端 token 通过 type=admin 隔离
JWT_ADMIN_EXPIRE_HOURS=2

# ---------------- 短信验证码 ----------------
# mock=不真实发送，验证码打印在后端日志；接真实短信服务商时替换实现
SMS_PROVIDER=mock
SMS_CODE_LENGTH=6
SMS_CODE_EXPIRE_MINUTES=5
SMS_DAILY_LIMIT=10

# ---------------- AI 大模型 ----------------
# mock=本地规则模板回复（离线陪伴兜底）；openai=走 OpenAI 兼容接口（如智谱 glm-4-flash）
AI_MODEL=mock
# 【敏感】大模型 API Key，写在 .env.local
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4o-mini
AI_MAX_TOKENS=300
AI_TEMPERATURE=0.8

# ---------------- 支付 ----------------
# mock=模拟收银台（订单真实落库，但不产生真实扣款）；接真实渠道时实现 PayProvider
PAY_PROVIDER=mock
# 【敏感】填写后 /pay/callback/mock 要求 HMAC 签名校验
PAY_MOCK_SECRET=

# ---------------- OCR 文字识别 ----------------
OCR_PROVIDER=mock
# 【敏感】真实 OCR 服务 Key
OCR_API_KEY=

# ---------------- TTS 语音合成 ----------------
# 生成的音频缓存在 server/tts_cache_audio/（已忽略入库）
TTS_PROVIDER=mock
# 【敏感】真实语音合成服务 Key
TTS_API_KEY=

# ---------------- ASR 语音识别 ----------------
# mock=返回模拟文本（响应体带 mock=true）；真实渠道未配 Key 时接口返回 503，不会伪造结果
ASR_PROVIDER=mock
# 【敏感】语音识别服务 Key
ASR_API_KEY=
ASR_API_BASE=https://api.openai.com/v1
ASR_MODEL=whisper-1

# ---------------- 实时通话 RTC（声网 Agora） ----------------
# none=关闭，/api/v1/rtc/* 返回 503，前端显示「演示模式 · 未接入实时通话」
# 启用时设为 agora，并填写下方两个 32 位十六进制凭证
RTC_PROVIDER=none
# token 有效期（秒），建议 600~3600
RTC_TOKEN_TTL=3600
# 【敏感】声网控制台创建项目后获取
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---------------- 翻译 ----------------
TRANSLATE_PROVIDER=mock
# 【敏感】真实翻译服务 Key
TRANSLATE_API_KEY=

# ---------------- 数据加密（AES-GCM） ----------------
# 【敏感】32 字节 hex 密钥（64 个十六进制字符）；留空则不启用加密
ENCRYPT_KEY=

# ---------------- 接口限流 ----------------
RATE_LIMIT_ENABLED=true
# 同一 IP 在窗口期内允许的登录失败次数
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15
# 仅在部署于可信反向代理（nginx 等）之后时设为 true；直连时开启会因伪造 X-Forwarded-For 绕过限流
TRUST_PROXY_HEADERS=false

# ---------------- 文件上传 ----------------
UPLOAD_DIR=uploads
# 单文件大小上限（字节），默认 10MB
UPLOAD_MAX_SIZE=10485760

# ---------------- 文件存储 ----------------
# local=存本机服务器磁盘；cos=腾讯云对象存储
STORAGE_TYPE=local
# 静态资源绝对地址前缀。留空=返回相对路径 /uploads/...（H5 走 vite 代理，换网络永不出错）
# 需要绝对地址时填：http://<局域网IP>:8000 或 https://your-domain.com
STATIC_BASE_URL=
# 【敏感】COS 存储凭证（STORAGE_TYPE=cos 时必填）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# ---------------- 微信小程序 ----------------
# 【敏感】小程序登录 / 订阅消息所需
WX_APPID=
WX_SECRET=

# ---------------- 跨域白名单（逗号分隔） ----------------
# development 环境会自动补上本机当前局域网 IP，无需手动维护
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:3000

# ---------------- 个推离线推送 ----------------
# false 或未填时自动降级为本地轮询通道，不影响消息提醒
GETUI_ENABLED=false
# 【敏感】个推控制台应用凭证
GETUI_APP_ID=
GETUI_APP_KEY=
GETUI_APP_SECRET=

# ===================================
# 附：前端构建变量（不属于后端，仅作查阅；写在 frontend/.env 中使用）
# ===================================
# App / 小程序打包时的后端绝对地址（H5 走 vite 代理，不需要）
# VITE_API_ORIGIN=https://your-domain.com
# 小程序 VIP 接口独立域名（不填则跟随 LAN_HOST）
# VITE_WX_VIP_ORIGIN=https://your-domain.com
#
# 前端冒烟测试变量（frontend/tests/smoke/pages.smoke.mjs，非 .env 必需）：
# SMOKE_BASE=http://127.0.0.1:8080
# SMOKE_API=http://127.0.0.1:8000
# SMOKE_USER=idea_test_a
# SMOKE_PASS=test123456
