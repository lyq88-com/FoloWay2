# ===================================
# AI习惯伙伴 - 生产环境配置
# 复制此文件为 .env 并填入真实值
# ===================================

# --- 应用 ---
APP_NAME=AI习惯伙伴
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- MySQL 数据库 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ai_habit_user
DB_PASSWORD=your_secure_password_here
DB_NAME=ai_habit_partner

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here

# --- JWT ---
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
JWT_ADMIN_EXPIRE_HOURS=2

# --- AI 大模型 ---
AI_MODEL=openai
AI_API_KEY=sk-your_openai_api_key_here
AI_API_BASE=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4o-mini
AI_MAX_TOKENS=300
AI_TEMPERATURE=0.8

# --- OCR ---
OCR_PROVIDER=mock
OCR_API_KEY=

# --- TTS ---
TTS_PROVIDER=mock
TTS_API_KEY=

# --- 文件上传 ---
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=10485760

# --- 微信小程序 ---
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# --- 跨域 ---
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# --- 短信 ---
SMS_PROVIDER=mock
SMS_CODE_LENGTH=6
SMS_CODE_EXPIRE_MINUTES=5
SMS_DAILY_LIMIT=10
